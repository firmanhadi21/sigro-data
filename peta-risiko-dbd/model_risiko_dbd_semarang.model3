    <Option type="Map" name="m7_indeks">
      <Option type="bool" value="true" name="active"/>
      <Option name="alg_config"/>
      <Option type="QString" value="native:fieldcalculator" name="alg_id"/>
      <Option type="QString" value="" name="color"/>
      <Option type="Map" name="comment">
        <Option type="QString" value="" name="color"/>
        <Option type="QString" value="" name="component_description"/>
        <Option type="double" value="60" name="component_height"/>
        <Option type="double" value="0" name="component_pos_x"/>
        <Option type="double" value="0" name="component_pos_y"/>
        <Option type="double" value="100" name="component_width"/>
        <Option type="bool" value="true" name="outputs_collapsed"/>
        <Option type="bool" value="true" name="parameters_collapsed"/>
      </Option>
      <Option type="QString" value="[M7] Hitung indeks risiko DBD (0-1)" name="component_description"/>
      <Option type="double" value="50" name="component_height"/>
      <Option type="double" value="760" name="component_pos_x"/>
      <Option type="double" value="920" name="component_pos_y"/>
      <Option type="double" value="250" name="component_width"/>
      <Option name="dependencies"/>
      <Option type="QString" value="m7_indeks" name="id"/>
      <Option name="outputs"/>
      <Option type="bool" value="true" name="outputs_collapsed"/>
      <Option type="bool" value="true" name="parameters_collapsed"/>
      <Option type="Map" name="params">
        <Option type="List" name="FIELD_LENGTH">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="int" value="10" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_NAME">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="QString" value="indeks_risiko" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_PRECISION">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="int" value="4" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_TYPE">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="int" value="0" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FORMULA">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="QString" value="round((to_real(@bobot_ir) * ((coalesce(&quot;ir_100rb&quot;, 0) - minimum(coalesce(&quot;ir_100rb&quot;, 0))) / nullif(maximum(coalesce(&quot;ir_100rb&quot;, 0)) - minimum(coalesce(&quot;ir_100rb&quot;, 0)), 0)) + to_real(@bobot_kde) * ((coalesce(&quot;kde_mean&quot;, 0) - minimum(coalesce(&quot;kde_mean&quot;, 0))) / nullif(maximum(coalesce(&quot;kde_mean&quot;, 0)) - minimum(coalesce(&quot;kde_mean&quot;, 0)), 0)) + to_real(@bobot_ch) * ((coalesce(&quot;ch_mean&quot;, 0) - minimum(coalesce(&quot;ch_mean&quot;, 0))) / nullif(maximum(coalesce(&quot;ch_mean&quot;, 0)) - minimum(coalesce(&quot;ch_mean&quot;, 0)), 0)) + to_real(@bobot_elev) * (1 - ((coalesce(&quot;elev_mean&quot;, 0) - minimum(coalesce(&quot;elev_mean&quot;, 0))) / nullif(maximum(coalesce(&quot;elev_mean&quot;, 0)) - minimum(coalesce(&quot;elev_mean&quot;, 0)), 0))) + to_real(@bobot_akses) * ((coalesce(&quot;HubDist_mean&quot;, 0) - minimum(coalesce(&quot;HubDist_mean&quot;, 0))) / nullif(maximum(coalesce(&quot;HubDist_mean&quot;, 0)) - minimum(coalesce(&quot;HubDist_mean&quot;, 0)), 0))) / (to_real(@bobot_ir) + to_real(@bobot_kde) + to_real(@bobot_ch) + to_real(@bobot_elev) + to_real(@bobot_akses)), 4)" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="INPUT">
          <Option type="Map">
            <Option type="QString" value="m4_akses" name="child_id"/>
            <Option type="QString" value="OUTPUT" name="output_name"/>
            <Option type="int" value="1" name="source"/>
          </Option>
        </Option>
      </Option>
    </Option>
