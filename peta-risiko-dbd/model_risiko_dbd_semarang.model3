          <Option type="bool" value="true" name="outputs_collapsed"/>
          <Option type="bool" value="true" name="parameters_collapsed"/>
        </Option>
      </Option>
      <Option type="bool" value="true" name="outputs_collapsed"/>
      <Option type="bool" value="true" name="parameters_collapsed"/>
      <Option type="Map" name="params">
        <Option type="List" name="FIELD_LENGTH">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="int" value="10" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_NAME">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="QString" value="kelas_risiko" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_PRECISION">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="int" value="0" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FIELD_TYPE">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="int" value="2" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="FORMULA">
          <Option type="Map">
            <Option type="int" value="2" name="source"/>
            <Option type="QString" value="CASE WHEN &quot;indeks_risiko&quot; >= mean(&quot;indeks_risiko&quot;) + stdev(&quot;indeks_risiko&quot;) THEN 'Tinggi' WHEN &quot;indeks_risiko&quot; >= mean(&quot;indeks_risiko&quot;) THEN 'Sedang' ELSE 'Rendah' END" name="static_value"/>
          </Option>
        </Option>
        <Option type="List" name="INPUT">
          <Option type="Map">
            <Option type="QString" value="m7_indeks" name="child_id"/>
            <Option type="QString" value="OUTPUT" name="output_name"/>
            <Option type="int" value="1" name="source"/>
          </Option>
        </Option>
      </Option>
    </Option>
  </Option>
  <Option name="designerParameterValues"/>
  <Option name="groupBoxes"/>
  <Option type="Map" name="help">
    <Option type="QString" value="Firman Hadi - Departemen Teknik Geodesi, Universitas Diponegoro" name="ALG_CREATOR"/>
    <Option type="QString" value="Model terpadu Pemodelan Spasial Minggu 1-7 (Teknik Geodesi UNDIP). Menggabungkan Points in Polygon, Heatmap (KDE), Nearest Neighbour &amp; jarak ke hub, sampling raster (titik &amp; poligon/zonal), interpolasi IDW, dan kalkulasi indeks risiko DBD per kelurahan. Semua input harus dalam CRS terproyeksi meter (mis. EPSG:32749 WGS 84 / UTM 49S)." name="ALG_DESC"/>
    <Option type="QString" value="1.0" name="ALG_VERSION"/>
    <Option type="QString" value="DEM (mis. Copernicus GLO-30 / DEMNAS) dalam CRS yang sama." name="dem"/>
    <Option type="QString" value="Field curah hujan pada layer stasiun." name="field_ch"/>
    <Option type="QString" value="Field jumlah penduduk pada layer kelurahan." name="field_penduduk"/>
    <Option type="QString" value="Field nama Puskesmas." name="field_pkm"/>
    <Option type="QString" value="Titik kasus DBD (alamat pasien yang telah digeokode)." name="kasus"/>
    <Option type="QString" value="Poligon batas kelurahan dengan field jumlah penduduk (penduduk)." name="kelurahan"/>
    <Option type="QString" value="Titik lokasi Puskesmas." name="puskesmas"/>
    <Option type="QString" value="Radius kernel heatmap (meter)." name="radius_kde"/>
    <Option type="QString" value="Titik stasiun/pos hujan dengan nilai curah hujan." name="stasiun"/>
    <Option type="QString" value="Ukuran piksel raster heatmap &amp; IDW (meter)." name="ukuran_piksel"/>
  </Option>
